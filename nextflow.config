/*
 * Root Nextflow config required by Seqera Platform (which looks for a
 * nextflow.config next to the repo-root main.nf). It delegates to the real
 * pipeline config under test/nextflow/ — all params, the container/process
 * settings, and the profiles (test, standard, awsbatch, ...) are defined there.
 * includeConfig paths inside that file resolve relative to it, so the
 * conf/hg002_grch38.config default data still loads correctly.
 */

includeConfig 'test/nextflow/nextflow.config'
