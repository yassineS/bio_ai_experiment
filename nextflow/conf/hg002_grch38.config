/*
 * conf/hg002_grch38.config — GIAB HG002 / GRCh38 data parameters.
 *
 * These are the DEFAULT inputs for the realbench pipeline: the GIAB "son"
 * (HG002 / NA24385) Ashkenazim-trio sample on the GRCh38 no-alt analysis set,
 * with the NIST v4.2.1 benchmark truth set. Everything is REAL GIAB data — no
 * synthetic inputs anywhere.
 *
 * !!! VERIFY EVERY KEY !!!  S3 keys on the GIAB mirror drift over time. Each
 * entry below is the best-known canonical path as of writing and is tagged
 * 'verify this key'. Before a real run, list the prefix and confirm the object
 * exists, e.g.:
 *
 *     aws s3 ls --no-sign-request \
 *         s3://giab/data/AshkenazimTrio/HG002_NA24385_son/
 *
 * S3-vs-HTTPS path note: the public bucket is s3://giab/ and its keys are
 * 'release/...' and 'data/...'. The NCBI *HTTPS* mirror inserts an extra
 * 'ftp/' segment (https://ftp-trace.ncbi.nlm.nih.gov/giab/ftp/data/...), and
 * the newer ReferenceSamples mirror uses
 * https://ftp-trace.ncbi.nlm.nih.gov/ReferenceSamples/giab/data/... — same
 * files, different prefixes. Use the s3:// form on AWS Batch (Nextflow stages
 * it natively and unsigned); use an https:// form for the local/test profile.
 */

params {

    // -----------------------------------------------------------------------
    // Reference: GRCh38 no-alt analysis set (GIAB references tree).
    // The published object is bgzipped (.fasta.gz) with .fai + .gzi indexes;
    // samtools faidx indexes it in place. To use a plain .fa, gunzip first and
    // point ref_fasta at the decompressed file.
    //   verify this key:
    // -----------------------------------------------------------------------
    ref_fasta = 's3://giab/release/references/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fasta.gz'   // verify this key

    // -----------------------------------------------------------------------
    // WGS BAM: HG002 GRCh38 Illumina ~300x (NHGRI AJtrio novoalign).
    // The full 300x BAM is ~560 GB; the chr20-only slice (~11 GB) is what the
    // `test` profile uses. For a real exome/wgs run point at the full BAM.
    //   verify this key:
    // -----------------------------------------------------------------------
    wgs_bam = 's3://giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/NHGRI_Illumina300X_AJtrio_novoalign_bams/HG002.GRCh38.300x.bam'        // verify this key
    wgs_bai = 's3://giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/NHGRI_Illumina300X_AJtrio_novoalign_bams/HG002.GRCh38.300x.bam.bai'    // verify this key

    // Alternative alignment as CRAM (leave null unless you prefer CRAM input;
    // if both BAM and CRAM are set the pipeline uses the BAM).
    wgs_cram = null
    wgs_crai = null

    // -----------------------------------------------------------------------
    // Benchmark truth: NIST GIAB v4.2.1, GRCh38.
    //   verify this key:
    // -----------------------------------------------------------------------
    benchmark_vcf = 's3://giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz'        // verify this key
    benchmark_tbi = 's3://giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi'    // verify this key

    // High-confidence region BED (the v4.2.1 "noinconsistent" callable BED).
    //   verify this key:
    highconf_bed = 's3://giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed'  // verify this key

    // -----------------------------------------------------------------------
    // Raw Illumina FASTQ (HG002, AshkenazimTrio). Used for the FASTQ-driven QC
    // cells (seqtk/sickle/skewer/fastp/prinseq) in the wgs tier; chr20/exome
    // tiers derive FASTQs from the region-sliced BAM instead.
    //   verify these keys (multiple lane files exist; pick one R1/R2 pair):
    // -----------------------------------------------------------------------
    fastq_r1 = 's3://giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/HG002Run01_S1/HG002_HiSeq300x_fastq/140528_D00360_0018_AH8VC6ADXX/Project_RM8391_RM8392/Sample_2A1/2A1_CGATGT_L001_R1_001.fastq.gz'   // verify this key
    fastq_r2 = 's3://giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/HG002Run01_S1/HG002_HiSeq300x_fastq/140528_D00360_0018_AH8VC6ADXX/Project_RM8391_RM8392/Sample_2A1/2A1_CGATGT_L001_R2_001.fastq.gz'   // verify this key

    // -----------------------------------------------------------------------
    // Exome capture target BED. There is no single "GIAB exome BED"; this MUST
    // be supplied/verified by the user to match the capture kit they care about.
    // Common choices (download and point exome_bed at the local/S3 copy):
    //   - Twist Comprehensive Exome  (Twist Bioscience, hg38)
    //   - IDT xGen Exome Research Panel v2 (hg38)
    //   - Agilent SureSelect Human All Exon V8 (hg38)
    //   - the GIAB-recommended exome target if you have one
    // The BED contig names MUST match the reference ('chr20' on GRCh38 no-alt).
    //   USER MUST SUPPLY / VERIFY:
    // -----------------------------------------------------------------------
    exome_bed = null   // e.g. 's3://<your-bucket>/exome_targets.GRCh38.bed'  — USER MUST SUPPLY/VERIFY

    // -----------------------------------------------------------------------
    // Gene annotation GFF3 (GRCh38) for the csq / subseq / gff-consuming cells.
    // RefSeq and Gencode are both fine; pick one and verify the key. The GIAB
    // mirror does not host annotation — these are the canonical providers.
    //   verify this key (choose RefSeq OR Gencode):
    // -----------------------------------------------------------------------
    // RefSeq (NCBI):
    gene_gff = 'https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/001/405/GCF_000001405.40_GRCh38.p14/GCF_000001405.40_GRCh38.p14_genomic.gff.gz'   // verify this key
    // Gencode alternative (Ensembl/Gencode):
    //   gene_gff = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.annotation.gff3.gz'   // verify this key
}
