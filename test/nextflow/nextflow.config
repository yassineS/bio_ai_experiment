/*
 * nextflow.config — realbench real-data parity + performance pipeline.
 *
 * Launchable locally with Docker (the `standard`/`local` profile) and on the
 * Seqera Platform / AWS Batch (the `awsbatch` profile). A `test` profile runs
 * the chr20-only tier against small public inputs.
 *
 * The GIAB HG002 / GRCh38 data defaults live in conf/hg002_grch38.config and are
 * pulled in here so a bare `nextflow run` already points at the canonical
 * dataset (verify/override the S3 keys — see that file).
 */

manifest {
    name            = 'realbench'
    author          = 'bio_ai_experiment'
    description     = 'Real-data (GIAB HG002/GRCh38) parity + performance benchmark of the Go bioinformatics ports vs upstream.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

// ---------------------------------------------------------------------------
//  Default parameters (GIAB HG002 / GRCh38). Override on the CLI, via
//  -params-file, or in a profile.
// ---------------------------------------------------------------------------
includeConfig 'conf/hg002_grch38.config'

params {
    tiers        = ['chr20', 'exome']
    reps         = 3
    // Only the small realbench reports (RUN_MATRIX JSON/MD + AGGREGATE summary)
    // are published; the large staged/derived intermediates are passed between
    // processes via channels and NOT published. On AWS Batch, set outdir to an
    // S3 path UNDER the compute-environment work prefix (the Batch instance role
    // is scoped to that prefix — a sibling prefix gets 403 on PutObject), e.g.
    //   --outdir s3://<your-work-bucket>/work/results
    outdir       = 'results'

    container    = 'ghcr.io/yassines/bio-ai-realbench:latest'
    our_bin      = '/opt/ours'
    upstream_bin = '/opt/upstream'
    // Absolute path to the realbench harness inside the image (Dockerfile builds
    // it to /usr/local/bin/realbench). RUN_MATRIX invokes it by this path rather
    // than a bare `realbench`, because the AWS Batch executor's task PATH does
    // not include /usr/local/bin — a bare command fails with exit 127
    // "command not found" there (Seqera Platform/Wave happened to include it, so
    // this only surfaced on a direct nf-amazon launch).
    realbench_bin = '/usr/local/bin/realbench'

    chrom        = 'chr20'
}

// ---------------------------------------------------------------------------
//  Every process runs in the same container that carries BOTH our binaries
//  (/opt/ours) and the upstream oracle binaries (/opt/upstream) plus the Go
//  realbench harness and awscli/jq.
// ---------------------------------------------------------------------------
process {
    container = params.container

    // Conservative defaults; the per-label overrides below scale up the heavy
    // DERIVE/RUN steps. Times/memory are sized for a GIAB-class WGS BAM.
    cpus   = 2
    memory = 4.GB
    time   = 2.h

    errorStrategy = { task.attempt <= 2 && task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2

    // STAGE_* steps are I/O bound (download + index).
    withName: 'STAGE_REF|STAGE_VCF|STAGE_GFF' {
        cpus   = 2
        memory = 4.GB
        time   = 4.h
    }
    withName: 'STAGE_ALIGN' {
        cpus   = 4
        memory = 8.GB
        time   = 8.h     // staging + indexing a ~300x WGS BAM is slow
    }

    // chr20 / exome subsetting: moderate.
    withLabel: 'derive' {
        cpus   = 4
        memory = 8.GB
        time   = 6.h
    }
    // wgs subsetting transcodes the whole genome (BAM<->CRAM): heavy.
    withLabel: 'derive_wgs' {
        cpus   = 8
        memory = 16.GB
        time   = 24.h
    }

    // The matrix harness baseline (chr20/exome). The wgs tier overrides these
    // in-process via per-tier cpus/memory/time closures (8 cpu / 32 GB / 48 h),
    // since wgs runs every cell on the full genome and is the heaviest step.
    withLabel: 'matrix' {
        cpus   = 4
        memory = 8.GB
        time   = 8.h
    }

    withName: 'AGGREGATE' {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }
}

// Capture run provenance.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html" }

// ---------------------------------------------------------------------------
//  Profiles
// ---------------------------------------------------------------------------
profiles {

    // Local Docker run (the default for `nextflow run -profile standard`).
    standard {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
    }

    // Alias of standard for muscle memory.
    local {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process.executor = 'local'
    }

    // Singularity/Apptainer (HPC) variant of the local executor.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.executor       = 'local'
    }

    // AWS Batch — the Seqera Platform compute-environment target. The work dir
    // and outdir live on S3; Nextflow stages s3:// inputs (e.g. s3://giab/...)
    // natively. Set these to your account's values (or let the Platform inject
    // them from the compute environment).
    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = System.getenv('AWS_BATCH_QUEUE') ?: 'realbench-queue'
        aws.region       = System.getenv('AWS_REGION') ?: 'us-east-1'
        // The GIAB inputs are a PUBLIC AWS Open Data bucket: the compute-env job
        // role reads s3://giab via the bucket's public policy (no GIAB grant
        // needed); the role only needs read/write on YOUR work/results bucket.
        // Keep anonymous=false so those signed work-bucket writes succeed —
        // signed reads to the public GIAB bucket work too. (For a credential-
        // free LOCAL run instead, use the https://s3.amazonaws.com/giab/...
        // mirror or set aws.client.anonymous=true with a local work dir.)
        aws.client.anonymous = false
        aws.batch.cliPath    = '/usr/local/bin/aws'
        // workDir is normally set on the CLI: -work-dir s3://<your-bucket>/work
        // (or by the Seqera Platform compute environment).
        docker.enabled   = true
    }

    // Small public-data smoke test: chr20 tier only, 1 rep. Points at the GIAB
    // chr20-only 300x BAM (≈11 GB) so it stays a single-chromosome run. Still
    // REAL data — just the smallest real slice GIAB publishes.
    test {
        params.tiers   = ['chr20']
        params.reps    = 1
        params.chrom   = 'chr20'
        // The GIAB 300x chr20 source is far too deep for a smoke test (the full
        // matrix takes hours). Downsample to ~5x so it runs in minutes on real
        // data. Drop/raise this (or set to null) for a deeper, slower run.
        params.subsample = 0.0167
        // Self-contained smallest run: every required input is a verified PUBLIC
        // GIAB key (no credentials), so `-profile test` launches with no extra
        // params. The 300x chr20-only BAM (~12 GB) is the smallest real WGS
        // alignment GIAB ships.
        params.ref_fasta     = 's3://giab/release/references/GRCh38/GCA_000001405.15_GRCh38_no_alt_analysis_set.fasta.gz'
        params.wgs_bam       = 's3://giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/NHGRI_Illumina300X_AJtrio_novoalign_bams/HG002.GRCh38.300x_chr20.bam'
        params.wgs_bai       = 's3://giab/data/AshkenazimTrio/HG002_NA24385_son/NIST_HiSeq_HG002_Homogeneity-10953946/NHGRI_Illumina300X_AJtrio_novoalign_bams/HG002.GRCh38.300x_chr20.bam.bai'
        params.benchmark_vcf = 's3://giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz'
        params.benchmark_tbi = 's3://giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark.vcf.gz.tbi'
        params.highconf_bed  = 's3://giab/release/AshkenazimTrio/HG002_NA24385_son/NISTv4.2.1/GRCh38/HG002_GRCh38_1_22_v4.2.1_benchmark_noinconsistent.bed'
        // chr-named Gencode GFF3 (drives the csq/subseq cells; exome tier off here).
        params.gene_gff      = 'https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_46/gencode.v46.annotation.gff3.gz'
        // exome_bed is unused in the chr20-only test; left null on purpose.
        params.exome_bed = null
    }
}

// Keep CRAM reference-free decode happy when a block lacks an embedded ref.
env {
    REF_PATH  = '/dev/null'
    REF_CACHE = '/tmp/ref_cache/%2s/%2s/%s'
}
