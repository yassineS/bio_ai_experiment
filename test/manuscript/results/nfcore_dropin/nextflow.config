// Run the nf-core module on the LOCAL executor with the host PATH — no
// container, no conda. This is what makes the drop-in swap possible: the
// module's `container`/`conda` directives are simply ignored when the engine
// isn't enabled, so `samtools` is resolved from PATH. run_dropin.sh puts either
// bin/upstream or bin/ours first on PATH for the two runs.
docker.enabled   = false
singularity.enabled = false
conda.enabled    = false
apptainer.enabled = false

process {
    executor = 'local'
    cpus     = 1
}
